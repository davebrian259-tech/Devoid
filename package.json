{
  "name": "devoid",
  "version": "0.1.0",
  "private": true,
  "description": "Devoid: a Zcash wallet built around one move, paying many recipients in a single shielded transaction.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node scripts/test.mjs",
    "engine:build": "cargo build --release --manifest-path engine/Cargo.toml",
    "engine:selftest": "node scripts/engine-selftest.mjs",
    "test:ui": "python3 scripts/ui-smoke.py",
    "build:site": "node scripts/build-site.mjs",
    "test:web": "python3 scripts/web-smoke.py",
    "test:site": "python3 scripts/site-smoke.py",
    "build": "node scripts/build-site.mjs",
    "build:engine": "node scripts/build-web-engine.mjs",
    "test:live": "python3 scripts/web-live.py"
  }
}
